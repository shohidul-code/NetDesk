{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run alembic *)",
      "Bash(uv run python -m scripts.*)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git log *)",
      "Bash(npm run *)"
    ],
    "ask": [
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
