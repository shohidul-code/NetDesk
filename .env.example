# Copy to .env and fill in the secrets. Never commit .env.
# Every comment sits on its own line: an inline comment after a value becomes part of the value.

# --- Required secrets: the app refuses to start without these ---
# Local Compose database on host port 5433 (5432 is often taken by a local PostgreSQL).
# For Neon, use ?ssl=require (asyncpg does not accept sslmode).
DATABASE_URL=postgresql+asyncpg://netdesk:netdesk@localhost:5433/netdesk
# 48+ random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-48-plus-random-characters

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# --- LLM (Phase 4): Gemini through its OpenAI-compatible endpoint ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=

# --- Embeddings (Phase 5): tei | hf_inference | fake ---
EMBEDDINGS_PROVIDER=tei
EMBEDDINGS_URL=http://embeddings:80
HF_TOKEN=

# --- Chat limits and kill switch (Phase 4) ---
CHAT_ENABLED=true
CHAT_DAILY_LIMIT_CUSTOMER=30
CHAT_DAILY_LIMIT_STAFF=100
CHAT_DAILY_LIMIT_GLOBAL=1500

# --- MCP (Phase 6) ---
# JSON list of Host headers the MCP endpoint accepts; add the Render host in production
MCP_ALLOWED_HOSTS=["localhost:8000","127.0.0.1:8000"]
MCP_STDIO_USER_EMAIL=admin@netdesk.demo

# --- Complaints: false makes complaint creation admin-only ---
ALLOW_CUSTOMER_COMPLAINTS=true

# --- Seed script (Phase 2): password for the synthetic demo accounts ---
SEED_DEMO_PASSWORD=
